{
  "$type": "com.example.app.handlers",
  "name": "Standard.site",
  "targets": [
    {
      "collection": "site.standard.publication",
      "template": "{value.url}"
    },
    {
      "collection": "site.standard.document",
      "template": "{value.site->url}{value.path}"
    },
    {
      "collection": "site.standard.graph.recommend",
      "template": "{value.document->site->url}{value.document->path}",
      "label": "Recommended post"
    },
    {
      "collection": "site.standard.graph.subscription",
      "template": "{value.publication->url}",
      "label": "Subscribed publication"
    }
  ],
  "createdAt": "2026-06-01T00:00:00.000Z"
}
