{
  "name": "@igalia-experiments/at-app-handlers",
  "version": "0.0.3",
  "description": "JSON handler definitions mapping AT Protocol record collections to the apps that can open them (com.example.app.handlers).",
  "author": "Nicolò Ribaudo",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.js",
    "prepack": "node scripts/build.js",
    "test": "node scripts/build.js && node --test"
  },
  "files": [
    "handlers",
    "index.d.ts",
    "index.json"
  ],
  "type": "module",
  "main": "./index.json",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.json"
    },
    "./*": "./handlers/*"
  },
  "publishConfig": {
    "access": "public"
  }
}
